;; -*- mode: wat -*-
(namespace $day22
  (type Pos (struct (field $y i32) (field $x i32)))
  (type State
    (struct
      (field $grid (ref $map.T))
      (field $pos (mut (ref Pos)))
      (field $dir (mut i32))))

  (func parse (param $lines (ref null $list<*>.T)) (param $mark i32) (result (ref $map.T))
    (locals (ref $map.T) $grid)
    (locals (ref $String) $line)
    (locals i32 $y $x)

    (local.set $grid
      (call $map.empty
        (closure () (param $k0.any anyref) (param $k1.any anyref) (result i32)
          (locals (ref Pos) $k0 $k1)
          (local.set $k0 (ref.cast (ref Pos) $k0.any))
          (local.set $k1 (ref.cast (ref Pos) $k1.any))
          (when (= (struct.get Pos $y $k0) (struct.get Pos $y $k1))
            (return (- (struct.get Pos $x $k0) (struct.get Pos $x $k1))))
          (- (struct.get Pos $y $k0) (struct.get Pos $y $k1)))))

    (loop $loopY
      (when (! (ref.is_null $lines))
        (local.set $line (call $list<$String>.head $lines))
        (local.set $x 0)
        (loop $loopX
          (when (i32.lt_u $x (array.len $line))
            (when (= (array.get_u $String $line $x) #\#)
              (drop (call $map.insert! $grid (struct.new Pos $y $x) (ref.i31 $mark))))
            (add! $x 1)
            (br $loopX)))
        (add! $y 1)
        (local.set $lines (call $list<*>.tail $lines))
        (br $loopY)))

    $grid)

  (func printMap (param $map (ref $map.T))
    (locals (ref $map.KVArray) $kvs)
    (locals (ref $map.KV) $kv)
    (locals (ref Pos) $pos)
    (locals i32 $i)

    (local.set $kvs (call $map.elements $map))

    (loop $loop
      (when (i32.lt_u $i (array.len $kvs))
        (local.set $kv (ref.cast (ref $map.KV) (array.get $map.KVArray $kvs $i)))
        (local.set $pos (ref.cast (ref Pos) (struct.get $map.KV $key $kv)))
        (when (i31.get_u (ref.cast i31ref (struct.get $map.KV $value $kv)))
          (call printPos $pos)
          (call $print.nl))

        (add! $i 1)
        (br $loop))))

  (func printPos (param $pos (ref Pos))
    (call $printStr "(")
    (call $printStr (call $formatI32 (struct.get Pos $y $pos)))
    (call $printStr ",")
    (call $printStr (call $formatI32 (struct.get Pos $x $pos)))
    (call $printStr ")"))

  (func printState (param $state (ref State))
    (call $printStr "\n=== ")
    (call printPos (struct.get State $pos $state))
    (call $printStr " ")
    (call $printChr (array.get_u $String "NESW" (struct.get State $dir $state)))
    (call $printStr.nl " ===")
    (call printMap (struct.get State $grid $state)))

  (func forward (param $pos (ref Pos)) (param $dir i32) (result (ref Pos))
    (locals i32 $y $x)
    (local.set $y (struct.get Pos $y $pos))
    (local.set $x (struct.get Pos $x $pos))
    (cond
      [(= $dir 0) (add! $y -1)]
      [(= $dir 1) (add! $x 1)]
      [(= $dir 2) (add! $y 1)]
      [(= $dir 3) (add! $x -1)]
      [otherwise unreachable])
    (return (struct.new Pos $y $x)))

  (func part0.step (param $state (ref State)) (result i32)
    (locals (ref $map.T) $grid)
    (locals (ref Pos) $pos)
    (locals i32 $isInfected $dir)
    (locals (ref null $map.KV) $kv)

    (local.set $grid (struct.get State $grid $state))
    (local.set $pos (struct.get State $pos $state))
    (local.set $dir (struct.get State $dir $state))

    (local.set $kv (call $map.lookup $grid $pos))
    (when (! (ref.is_null $kv))
      (local.set $isInfected (i31.get_u (ref.cast i31ref (struct.get $map.KV $value $kv)))))

    (if $isInfected
      (then (add! $dir 1))
      (else (add! $dir -1)))
    (local.set $dir (i32.and $dir 3))
    (drop (call $map.insert! $grid $pos (ref.i31 (! $isInfected))))
    (local.set $pos (call forward $pos $dir))

    (struct.set State $pos $state $pos)
    (struct.set State $dir $state $dir)

    (! $isInfected))

  (indirect_func part0 (param $lines (ref null $list<*>.T)) (result i64)
    (locals (ref State) $state)
    (locals (ref $map.T) $grid)
    (locals i32 $mid $i $total)

    (local.set $mid (i32.shr_u (call $list<*>.len $lines) 1))

    (local.set $state
      (struct.new State
        (call parse $lines 1)
        (struct.new Pos $mid $mid)
        0))

    (loop $loop
      (when (i32.lt_u $i 10000)
        (add! $total (call part0.step $state))
        (add! $i 1)
        (br $loop)))

    (i64.extend_i32_s $total))

  (func part1.step (param $state (ref State)) (result i32)
    (locals (ref $map.T) $grid)
    (locals (ref Pos) $pos)
    (locals i32 $nodeState $dir)
    (locals (ref null $map.KV) $kv)

    (local.set $grid (struct.get State $grid $state))
    (local.set $pos (struct.get State $pos $state))
    (local.set $dir (struct.get State $dir $state))

    (local.set $kv (call $map.lookup $grid $pos))
    (when (! (ref.is_null $kv))
      (local.set $nodeState (i31.get_u (ref.cast i31ref (struct.get $map.KV $value $kv)))))

    (add! $dir (- $nodeState 1))
    (local.set $dir (i32.and $dir 3))

    (add! $nodeState 1)
    (local.set $nodeState (i32.and $nodeState 3))

    (drop (call $map.insert! $grid $pos (ref.i31 $nodeState)))
    (local.set $pos (call forward $pos $dir))

    (struct.set State $pos $state $pos)
    (struct.set State $dir $state $dir)

    (= $nodeState 2))

  (indirect_func part1 (param $lines (ref null $list<*>.T)) (result i64)
    (locals (ref State) $state)
    (locals (ref $map.T) $grid)
    (locals i32 $mid $i $total)

    (local.set $mid (i32.shr_u (call $list<*>.len $lines) 1))

    (local.set $state
      (struct.new State
        (call parse $lines 2)
        (struct.new Pos $mid $mid)
        0))

    (loop $loop
      (when (i32.lt_u $i 10000000)
        (add! $total (call part1.step $state))
        (add! $i 1)
        (br $loop)))

    (i64.extend_i32_s $total))

  (indirect_func main (result i32)
    (+
      (call $day-utils.checkI64
        "day-22/input-ex0.txt"
        (funcref part0) (i64 5587)
        (funcref part1) (i64 2511944))
      (call $day-utils.checkI64
        "day-22/input-real0.txt"
        (funcref part0) (i64 5369)
        (funcref part1) (i64 2510774))
      0)))
