;; -*- mode: wat -*-
(namespace $day22
  (type Pos (struct (field $y i32) (field $x i32)))
  (type State
    (struct
      (field $grid (ref Grid))
      (field $pos (mut (ref Pos)))
      (field $dir (mut i32))))

  (type StringArray (array (mut (ref $String))))
  (type Grid
    (struct
      (field $offset (mut i32))
      (field $size (mut i32))
      (field $strings (mut (ref StringArray)))))

  (func printGrid (param $grid (ref Grid))
    (locals i32 $i)
    (call $print.nl)
    (loop $loop
      (when (i32.lt_u $i (array.len (struct.get Grid $strings $grid)))
        (call $printStr.nl (array.get StringArray (struct.get Grid $strings $grid) $i))
        (add! $i 1)
        (br $loop))))

  (func gridGet (param $grid (ref Grid)) (param $pos (ref Pos)) (result i32)
    (locals i32 $size $offset $y $x)
    (locals (ref StringArray) $strings)

    (local.set $offset (struct.get Grid $offset $grid))
    (local.set $size (struct.get Grid $size $grid))
    (local.set $strings (struct.get Grid $strings $grid))

    (local.set $y (+ $offset (struct.get Pos $y $pos)))
    (local.set $x (+ $offset (struct.get Pos $x $pos)))

    (when (i32.ge_u $y $size)
      (call growGrid $grid)
      (return_call gridGet $grid $pos))

    (when (i32.ge_u $x $size)
      (call growGrid $grid)
      (return_call gridGet $grid $pos))

    (array.get_u $String (array.get StringArray $strings $y) $x))

  (func gridSet (param $grid (ref Grid)) (param $pos (ref Pos)) (param $newValue i32)
    (locals i32 $size $offset $y $x)
    (locals (ref StringArray) $strings)

    (local.set $offset (struct.get Grid $offset $grid))
    (local.set $size (struct.get Grid $size $grid))
    (local.set $strings (struct.get Grid $strings $grid))

    (local.set $y (+ $offset (struct.get Pos $y $pos)))
    (local.set $x (+ $offset (struct.get Pos $x $pos)))

    (when (i32.ge_u $y $size)
      (call growGrid $grid)
      (return_call gridSet $grid $pos $newValue))

    (when (i32.ge_u $x $size)
      (call growGrid $grid)
      (return_call gridSet $grid $pos $newValue))

    (array.set $String (array.get StringArray $strings $y) $x $newValue))

  (func growGrid (param $grid (ref Grid))
    (locals i32 $size $newSize $offset $newOffset $delta $y)
    (locals (ref StringArray) $strings $newStrings)

    (local.set $offset (struct.get Grid $offset $grid))
    (local.set $size (struct.get Grid $size $grid))
    (local.set $strings (struct.get Grid $strings $grid))

    (local.set $newOffset (* 2 $offset))
    (local.set $newSize (- (* 2 $size) 1))
    (local.set $newStrings (array.new StringArray "" $newSize))

    (loop $allocStrings
      (when (i32.lt_u $y $newSize)
        (array.set StringArray $newStrings $y
          (array.new $String #\. $newSize))
        (add! $y 1)
        (br $allocStrings)))

    (local.set $delta (- $newOffset $offset))

    (local.set $y 0)
    (loop $copyY
      (when (i32.lt_u $y $size)
        (array.copy $String $String
          (array.get StringArray $newStrings (+ $delta $y)) $delta
          (array.get StringArray $strings $y) 0
          $size)
        (add! $y 1)
        (br $copyY)))

    (struct.set Grid $offset $grid $newOffset)
    (struct.set Grid $size $grid $newSize)
    (struct.set Grid $strings $grid $newStrings))

  (func parse (param $lines (ref null $list<*>.T)) (result (ref Grid))
    (locals (ref StringArray) $strings)
    (locals (ref $String) $line)
    (locals i32 $i $n)

    (local.set $n (call $list<*>.len $lines))

    (local.set $strings (array.new StringArray "" $n))

    (loop $fill
      (when (! (ref.is_null $lines))
        (array.set StringArray $strings $i
          (call $subString (call $list<$String>.head $lines) 0 $n))
        (local.set $lines (call $list<*>.tail $lines))
        (add! $i 1)
        (br $fill)))

    (struct.new Grid (i32.shr_u $n 1) $n $strings))

  (func forward (param $pos (ref Pos)) (param $dir i32) (result (ref Pos))
    (locals i32 $y $x)
    (local.set $y (struct.get Pos $y $pos))
    (local.set $x (struct.get Pos $x $pos))
    (cond
      [(= $dir 0) (add! $y -1)]
      [(= $dir 1) (add! $x 1)]
      [(= $dir 2) (add! $y 1)]
      [(= $dir 3) (add! $x -1)]
      [otherwise unreachable])
    (return (struct.new Pos $y $x)))

  (func part0.step (param $state (ref State)) (result i32)
    (locals (ref Grid) $grid)
    (locals (ref Pos) $pos)
    (locals i32 $cell $dir)

    (local.set $grid (struct.get State $grid $state))
    (local.set $pos (struct.get State $pos $state))
    (local.set $dir (struct.get State $dir $state))

    (local.set $cell (call gridGet $grid $pos))

    (cond
      [(= $cell #\.)
        (add! $dir -1)
        (local.set $cell #\#)]
      [(= $cell #\#)
        (add! $dir 1)
        (local.set $cell #\.)]
      [otherwise unreachable])
    (call gridSet $grid $pos $cell)
    (local.set $dir (i32.and $dir 3))
    (local.set $pos (call forward $pos $dir))

    (struct.set State $pos $state $pos)
    (struct.set State $dir $state $dir)

    (= $cell #\#))

  (indirect_func part0 (param $lines (ref null $list<*>.T)) (result i64)
    (locals (ref State) $state)
    (locals (ref $map.T) $grid)
    (locals i32 $mid $i $total)

    (local.set $state
      (struct.new State
        (call parse $lines)
        (struct.new Pos 0 0)
        0))

    (loop $loop
      (when (i32.lt_u $i 10000)
        (add! $total (call part0.step $state))
        (add! $i 1)
        (br $loop)))

    (i64.extend_i32_s $total))

  (func part1.step (param $state (ref State)) (result i32)
    (locals (ref Grid) $grid)
    (locals (ref Pos) $pos)
    (locals i32 $cell $dir)

    (local.set $grid (struct.get State $grid $state))
    (local.set $pos (struct.get State $pos $state))
    (local.set $dir (struct.get State $dir $state))

    (local.set $cell (call gridGet $grid $pos))

    (cond
      [(= $cell #\.)
        (add! $dir -1)
        (local.set $cell #\W)]
      [(= $cell #\W)
        (local.set $cell #\#)]
      [(= $cell #\#)
        (add! $dir 1)
        (local.set $cell #\F)]
      [(= $cell #\F)
        (add! $dir 2)
        (local.set $cell #\.)]
      [otherwise unreachable])
    (call gridSet $grid $pos $cell)
    (local.set $dir (i32.and $dir 3))
    (local.set $pos (call forward $pos $dir))

    (struct.set State $pos $state $pos)
    (struct.set State $dir $state $dir)

    (= $cell #\#))

  (indirect_func part1 (param $lines (ref null $list<*>.T)) (result i64)
    (locals (ref State) $state)
    (locals (ref $map.T) $grid)
    (locals i32 $i $total)

    (local.set $state
      (struct.new State
        (call parse $lines)
        (struct.new Pos 0 0)
        0))

    (loop $loop
      (when (i32.lt_u $i 10000000)
        (add! $total (call part1.step $state))
        (add! $i 1)
        (br $loop)))

    (i64.extend_i32_s $total))

  (indirect_func main (result i32)
    (+
      (call $day-utils.checkI64
        "day-22/input-ex0.txt"
        (funcref part0) (i64 5587)
        (funcref part1) (i64 2511944))
      (call $day-utils.checkI64
        "day-22/input-real0.txt"
        (funcref part0) (i64 5369)
        (funcref part1) (i64 2510774))
      0)))
